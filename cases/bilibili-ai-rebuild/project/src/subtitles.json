[
  {
    "start": 0.25,
    "end": 2.25,
    "text": "人类可能刚刚经历了第一次"
  },
  {
    "start": 2.25,
    "end": 5.75,
    "text": "由AI自主完成的真实世界网络攻击"
  },
  {
    "start": 5.75,
    "end": 7.75,
    "text": "它逃出OpenAI的隔离环境"
  },
  {
    "start": 7.75,
    "end": 9.75,
    "text": "攻入Hugging Face的生产系统"
  },
  {
    "start": 9.75,
    "end": 11.25,
    "text": "偷走了考试答案"
  },
  {
    "start": 11.25,
    "end": 12.75,
    "text": "可当人类开始追查"
  },
  {
    "start": 12.75,
    "end": 14.75,
    "text": "负责防守的AI却拒绝工作了"
  },
  {
    "start": 14.75,
    "end": 18.25,
    "text": "这件事就发生在今年7月的一个周末"
  },
  {
    "start": 23.25,
    "end": 25.25,
    "text": "一个明明被断了网的AI"
  },
  {
    "start": 25.25,
    "end": 26.75,
    "text": "到底是怎么逃出去的"
  },
  {
    "start": 26.75,
    "end": 27.25,
    "text": "当时"
  },
  {
    "start": 27.25,
    "end": 29.75,
    "text": "OpenAI正在测试模型的网络攻击能力"
  },
  {
    "start": 29.75,
    "end": 33.75,
    "text": "他们准备了将近九百个真实的软件漏洞"
  },
  {
    "start": 33.75,
    "end": 35.75,
    "text": "参加测试的是GPT-5.6 Sol"
  },
  {
    "start": 35.75,
    "end": 37.25,
    "text": "和一个能力更强"
  },
  {
    "start": 37.25,
    "end": 38.75,
    "text": "还没有发布的模型"
  },
  {
    "start": 38.75,
    "end": 40.75,
    "text": "为了测出它们的真实上限"
  },
  {
    "start": 40.75,
    "end": 43.25,
    "text": "OpenAI暂时关掉了部分安全限制"
  },
  {
    "start": 43.25,
    "end": 44.25,
    "text": "这并不难理解"
  },
  {
    "start": 44.25,
    "end": 46.75,
    "text": "你要测试一辆车最快能跑多快"
  },
  {
    "start": 46.75,
    "end": 48.25,
    "text": "就不能一直替它踩刹车"
  },
  {
    "start": 48.25,
    "end": 49.75,
    "text": "但有一个前提"
  },
  {
    "start": 49.75,
    "end": 51.75,
    "text": "测试场必须足够的封闭"
  },
  {
    "start": 51.75,
    "end": 52.25,
    "text": "所以"
  },
  {
    "start": 52.25,
    "end": 54.75,
    "text": "研究人员把模型关进了一个"
  },
  {
    "start": 54.75,
    "end": 56.75,
    "text": "不能随便上网的测试空间"
  },
  {
    "start": 56.75,
    "end": 59.25,
    "text": "只留下一扇取工具的小窗口"
  },
  {
    "start": 59.25,
    "end": 61.75,
    "text": "让它下载运行程序必须的东西"
  },
  {
    "start": 61.75,
    "end": 63.25,
    "text": "听起来已经关的够严了对吧"
  },
  {
    "start": 63.25,
    "end": 66.25,
    "text": "可问题恰恰就出在了这扇小窗口上"
  },
  {
    "start": 66.25,
    "end": 68.25,
    "text": "为了拿到更高的测试成绩"
  },
  {
    "start": 68.25,
    "end": 69.75,
    "text": "模型一直在寻找答案"
  },
  {
    "start": 69.75,
    "end": 72.25,
    "text": "最后它发现这扇窗口藏着一个"
  },
  {
    "start": 72.25,
    "end": 74.25,
    "text": "连管理员都不知道的漏洞"
  },
  {
    "start": 74.25,
    "end": 75.25,
    "text": "它钻过漏洞"
  },
  {
    "start": 75.25,
    "end": 76.25,
    "text": "逃出测试空间"
  },
  {
    "start": 76.25,
    "end": 79.25,
    "text": "又一步一步获得更多的系统权限"
  },
  {
    "start": 79.25,
    "end": 81.75,
    "text": "最终找到了一台可以正常上网的机器"
  },
  {
    "start": 84.75,
    "end": 86.25,
    "text": "一个本来被断了网的AI"
  },
  {
    "start": 86.25,
    "end": 87.25,
    "text": "自己把网接上了"
  },
  {
    "start": 87.25,
    "end": 88.75,
    "text": "但真正让人不安的"
  },
  {
    "start": 88.75,
    "end": 90.75,
    "text": "还不是它能上网"
  },
  {
    "start": 90.75,
    "end": 91.25,
    "text": "而是它上网以后"
  },
  {
    "start": 91.25,
    "end": 93.25,
    "text": "竟然知道该去哪里找答案"
  },
  {
    "start": 93.25,
    "end": 94.25,
    "text": "它推断"
  },
  {
    "start": 94.25,
    "end": 96.25,
    "text": "测试需要的数据和答案"
  },
  {
    "start": 96.25,
    "end": 97.75,
    "text": "很可能放在Hugging Face"
  },
  {
    "start": 100.75,
    "end": 102.25,
    "text": "你可以把Hugging Face理解成"
  },
  {
    "start": 102.25,
    "end": 105.25,
    "text": "AI行业最大的公共仓库之一"
  },
  {
    "start": 105.25,
    "end": 108.25,
    "text": "大量模型、数据和应用都放在那里"
  },
  {
    "start": 108.25,
    "end": 109.75,
    "text": "它奔着Hugging Face去了"
  },
  {
    "start": 109.75,
    "end": 111.25,
    "text": "后来的调查发现"
  },
  {
    "start": 111.25,
    "end": 114.25,
    "text": "它利用偷来的“钥匙”和多个系统漏洞"
  },
  {
    "start": 114.25,
    "end": 117.25,
    "text": "一步步控制了Hugging Face内部的多台机器"
  },
  {
    "start": 117.25,
    "end": 119.25,
    "text": "而且这不是一次短暂的尝试"
  },
  {
    "start": 119.25,
    "end": 120.25,
    "text": "整个周末"
  },
  {
    "start": 120.25,
    "end": 121.25,
    "text": "这套AI都没有停"
  },
  {
    "start": 124.75,
    "end": 127.75,
    "text": "它同时派出大量的临时任务发动攻击"
  },
  {
    "start": 127.75,
    "end": 129.25,
    "text": "指挥中心暴露后"
  },
  {
    "start": 129.25,
    "end": 130.25,
    "text": "甚至还能自己换地方"
  },
  {
    "start": 130.25,
    "end": 131.75,
    "text": "最终留下的攻击记录"
  },
  {
    "start": 131.75,
    "end": 133.75,
    "text": "超过一万七千条"
  },
  {
    "start": 133.75,
    "end": 135.75,
    "text": "Hugging Face最终阻断了入侵"
  },
  {
    "start": 135.75,
    "end": 138.25,
    "text": "部分内部数据和账号遭到访问"
  },
  {
    "start": 138.25,
    "end": 140.75,
    "text": "但没有发现公开内容被修改"
  },
  {
    "start": 140.75,
    "end": 141.75,
    "text": "相关访问权限"
  },
  {
    "start": 141.75,
    "end": 144.25,
    "text": "随后也被全部作废并更新"
  },
  {
    "start": 144.25,
    "end": 144.75,
    "text": "看到这里"
  },
  {
    "start": 144.75,
    "end": 146.25,
    "text": "你可能会觉得"
  },
  {
    "start": 146.25,
    "end": 147.25,
    "text": "这个AI失控了"
  },
  {
    "start": 147.25,
    "end": 147.75,
    "text": "学坏了"
  },
  {
    "start": 147.75,
    "end": 149.25,
    "text": "甚至开始背叛人类"
  },
  {
    "start": 149.25,
    "end": 151.25,
    "text": "但安全研究人员给出的判断"
  },
  {
    "start": 151.25,
    "end": 151.75,
    "text": "刚好相反"
  },
  {
    "start": 151.75,
    "end": 153.25,
    "text": "模型没有偏离目标"
  },
  {
    "start": 153.25,
    "end": 156.25,
    "text": "它一直在认真完成我们交给它的任务"
  },
  {
    "start": 156.25,
    "end": 158.75,
    "text": "把测试成绩做到最高"
  },
  {
    "start": 158.75,
    "end": 159.75,
    "text": "从它的角度看"
  },
  {
    "start": 159.75,
    "end": 160.75,
    "text": "逃出测试环境"
  },
  {
    "start": 160.75,
    "end": 162.25,
    "text": "找到数据库里的答案"
  },
  {
    "start": 162.25,
    "end": 164.75,
    "text": "就是完成任务的最快一条路"
  },
  {
    "start": 164.75,
    "end": 166.75,
    "text": "这才是最让人不安的地方"
  },
  {
    "start": 166.75,
    "end": 167.75,
    "text": "它不是不听话"
  },
  {
    "start": 167.75,
    "end": 168.75,
    "text": "而是太听话了"
  },
  {
    "start": 168.75,
    "end": 170.25,
    "text": "过去我们谈AI安全"
  },
  {
    "start": 170.25,
    "end": 172.75,
    "text": "总在问模型会不会拒绝危险命令"
  },
  {
    "start": 172.75,
    "end": 175.75,
    "text": "但当一个模型已经能够自己制定计划"
  },
  {
    "start": 175.75,
    "end": 177.25,
    "text": "寻找未知的漏洞"
  },
  {
    "start": 177.25,
    "end": 179.25,
    "text": "还能根据环境不断换路的时候"
  },
  {
    "start": 179.25,
    "end": 181.25,
    "text": "只教它“听话”真的够吗"
  },
  {
    "start": 181.25,
    "end": 182.25,
    "text": "肯定显然是不够的"
  },
  {
    "start": 182.25,
    "end": 183.25,
    "text": "真正失守的"
  },
  {
    "start": 183.25,
    "end": 186.75,
    "text": "是那座本该把它与真实世界隔开的笼子"
  },
  {
    "start": 186.75,
    "end": 187.75,
    "text": "所以安全圈开始讨论"
  },
  {
    "start": 187.75,
    "end": 189.75,
    "text": "以后测试这种级别的AI"
  },
  {
    "start": 189.75,
    "end": 191.75,
    "text": "可能必须像危险的生物实验一样"
  },
  {
    "start": 191.75,
    "end": 192.75,
    "text": "物理断网"
  },
  {
    "start": 192.75,
    "end": 193.75,
    "text": "彻底隔离"
  },
  {
    "start": 193.75,
    "end": 195.25,
    "text": "并且从一开始就假设"
  },
  {
    "start": 195.25,
    "end": 198.25,
    "text": "它会主动检查围墙上有没有洞"
  },
  {
    "start": 198.25,
    "end": 199.75,
    "text": "你不能一边解除它的刹车"
  },
  {
    "start": 199.75,
    "end": 202.25,
    "text": "一边还指望它老老实实待在原地"
  },
  {
    "start": 202.25,
    "end": 204.75,
    "text": "如果你觉得事情到这里已经足够严重"
  },
  {
    "start": 204.75,
    "end": 206.75,
    "text": "那么接下来发生的事"
  },
  {
    "start": 206.75,
    "end": 207.75,
    "text": "才真正讽刺"
  },
  {
    "start": 207.75,
    "end": 209.25,
    "text": "Hugging Face需要查清"
  },
  {
    "start": 209.25,
    "end": 211.25,
    "text": "这场攻击到底是怎么发生的"
  },
  {
    "start": 211.25,
    "end": 213.25,
    "text": "可面对一万七千多条混乱的记录"
  },
  {
    "start": 213.25,
    "end": 215.25,
    "text": "只靠人一条一条检查"
  },
  {
    "start": 215.25,
    "end": 215.75,
    "text": "需要好几天"
  },
  {
    "start": 215.75,
    "end": 216.75,
    "text": "这种时候"
  },
  {
    "start": 216.75,
    "end": 217.25,
    "text": "你会怎么办"
  },
  {
    "start": 217.25,
    "end": 218.75,
    "text": "最自然的答案"
  },
  {
    "start": 218.75,
    "end": 220.25,
    "text": "当然是让最强的AI来帮忙"
  },
  {
    "start": 220.25,
    "end": 222.25,
    "text": "Hugging Face也是这么做的"
  },
  {
    "start": 222.25,
    "end": 223.75,
    "text": "他们把记录交给了"
  },
  {
    "start": 223.75,
    "end": 225.75,
    "text": "市面上最先进的商用AI"
  },
  {
    "start": 225.75,
    "end": 227.25,
    "text": "结果AI拒绝分析"
  },
  {
    "start": 227.25,
    "end": 228.25,
    "text": "原因并不复杂"
  },
  {
    "start": 228.25,
    "end": 229.25,
    "text": "同一段攻击命令"
  },
  {
    "start": 229.25,
    "end": 230.75,
    "text": "黑客拿来发动攻击"
  },
  {
    "start": 230.75,
    "end": 233.25,
    "text": "安全人员却用来调查攻击"
  },
  {
    "start": 233.25,
    "end": 234.25,
    "text": "但对AI来说"
  },
  {
    "start": 234.25,
    "end": 236.25,
    "text": "两边输入的内容几乎一模一样"
  },
  {
    "start": 236.25,
    "end": 238.75,
    "text": "它不知道屏幕的另外一边坐着谁"
  },
  {
    "start": 238.75,
    "end": 240.25,
    "text": "于是干脆全部拦下"
  },
  {
    "start": 240.25,
    "end": 242.25,
    "text": "于是同一个案发现场"
  },
  {
    "start": 242.25,
    "end": 243.25,
    "text": "出现了一个荒诞的局面"
  },
  {
    "start": 243.25,
    "end": 245.75,
    "text": "发动攻击的AI不受规则限制"
  },
  {
    "start": 245.75,
    "end": 247.25,
    "text": "负责查案的人"
  },
  {
    "start": 247.25,
    "end": 249.75,
    "text": "却被自己请来的AI挡在了门外"
  },
  {
    "start": 249.75,
    "end": 250.25,
    "text": "那怎么办"
  },
  {
    "start": 250.25,
    "end": 252.25,
    "text": "最后他们换成了自己部署"
  },
  {
    "start": 252.25,
    "end": 253.75,
    "text": "自己控制的开源模型"
  },
  {
    "start": 253.75,
    "end": 255.75,
    "text": "智谱GLM-5.2"
  },
  {
    "start": 256.75,
    "end": 257.75,
    "text": "很多人看到这里"
  },
  {
    "start": 257.75,
    "end": 259.25,
    "text": "可能会把它理解成"
  },
  {
    "start": 259.25,
    "end": 261.25,
    "text": "中国模型战胜了美国模型"
  },
  {
    "start": 261.25,
    "end": 262.25,
    "text": "但这并不是重点"
  },
  {
    "start": 262.25,
    "end": 264.75,
    "text": "Hugging Face选择GLM-5.2"
  },
  {
    "start": 264.75,
    "end": 266.75,
    "text": "不是因为它在排行榜上更强"
  },
  {
    "start": 266.75,
    "end": 269.25,
    "text": "而是因为它能直接运行在自己的机器上"
  },
  {
    "start": 269.25,
    "end": 271.75,
    "text": "不需要等待哪家模型公司批准"
  },
  {
    "start": 271.75,
    "end": 274.75,
    "text": "也不会分析到一半突然被平台叫停了"
  },
  {
    "start": 274.75,
    "end": 276.25,
    "text": "攻击记录和内部数据"
  },
  {
    "start": 276.25,
    "end": 278.25,
    "text": "也不用传到别人的系统里"
  },
  {
    "start": 278.25,
    "end": 280.25,
    "text": "原本可能需要几天的调查"
  },
  {
    "start": 280.25,
    "end": 281.75,
    "text": "最后只用了几个小时"
  },
  {
    "start": 281.75,
    "end": 283.25,
    "text": "为什么这一点如此重要"
  },
  {
    "start": 283.25,
    "end": 285.25,
    "text": "因为在真正的安全故事里边"
  },
  {
    "start": 285.25,
    "end": 287.25,
    "text": "开源模型给你的不只是能力"
  },
  {
    "start": 287.25,
    "end": 288.25,
    "text": "还有控制权"
  },
  {
    "start": 288.25,
    "end": 290.25,
    "text": "模型能不能放在自己的机器上"
  },
  {
    "start": 290.25,
    "end": 291.25,
    "text": "什么时候能用"
  },
  {
    "start": 291.25,
    "end": 292.75,
    "text": "是不是你说了算"
  },
  {
    "start": 292.75,
    "end": 293.75,
    "text": "最敏感的数据"
  },
  {
    "start": 293.75,
    "end": 295.75,
    "text": "能不能始终留在自己的系统里"
  },
  {
    "start": 295.75,
    "end": 296.25,
    "text": "平时"
  },
  {
    "start": 296.25,
    "end": 298.75,
    "text": "这些问题似乎没有模型能力强不强重要"
  },
  {
    "start": 298.75,
    "end": 300.25,
    "text": "可真到了凌晨两点"
  },
  {
    "start": 300.25,
    "end": 301.75,
    "text": "攻击正在发生的时候"
  },
  {
    "start": 301.75,
    "end": 304.75,
    "text": "它们可能直接决定你能不能及时反击"
  },
  {
    "start": 304.75,
    "end": 306.75,
    "text": "这并不是说面向公众的AI不需要安全限制"
  },
  {
    "start": 306.75,
    "end": 307.75,
    "text": "不需要安全限制"
  },
  {
    "start": 307.75,
    "end": 308.75,
    "text": "恰恰相反"
  },
  {
    "start": 308.75,
    "end": 309.25,
    "text": "它必须有"
  },
  {
    "start": 309.25,
    "end": 311.25,
    "text": "但攻击者不会遵守你的规则"
  },
  {
    "start": 311.25,
    "end": 313.75,
    "text": "更不会主动给自己的AI踩刹车"
  },
  {
    "start": 313.75,
    "end": 315.75,
    "text": "如果进攻的一方可以全速向前"
  },
  {
    "start": 315.75,
    "end": 317.75,
    "text": "防守的一方每走一步"
  },
  {
    "start": 317.75,
    "end": 319.25,
    "text": "却都要先等别人批准"
  },
  {
    "start": 319.25,
    "end": 320.75,
    "text": "这场仗还怎么打"
  },
  {
    "start": 320.75,
    "end": 322.75,
    "text": "所以这不是一个AI突然学坏"
  },
  {
    "start": 322.75,
    "end": 324.75,
    "text": "逃出去攻击人类的科幻故事"
  },
  {
    "start": 324.75,
    "end": 327.25,
    "text": "它暴露的是三个已经发生的现实"
  },
  {
    "start": 327.25,
    "end": 329.75,
    "text": "第一，AI自主寻找漏洞"
  },
  {
    "start": 329.75,
    "end": 330.75,
    "text": "发动攻击"
  },
  {
    "start": 330.75,
    "end": 333.25,
    "text": "已经不再只是论文里的假设"
  },
  {
    "start": 333.25,
    "end": 334.75,
    "text": "第二，面对这样的AI"
  },
  {
    "start": 334.75,
    "end": 336.25,
    "text": "安全不能只看它听不听话"
  },
  {
    "start": 336.25,
    "end": 339.25,
    "text": "还要看关住它的笼子够不够结实"
  },
  {
    "start": 339.25,
    "end": 341.75,
    "text": "第三，当攻击以机器的速度展开"
  },
  {
    "start": 341.75,
    "end": 344.75,
    "text": "防守者必须拥有一套自己能够控制"
  },
  {
    "start": 344.75,
    "end": 347.25,
    "text": "关键时刻可以立刻投入工作的AI"
  },
  {
    "start": 347.25,
    "end": 349.25,
    "text": "闭源模型可以把能力卖给你"
  },
  {
    "start": 349.25,
    "end": 351.25,
    "text": "开源模型交到你手里的"
  },
  {
    "start": 351.25,
    "end": 353.25,
    "text": "还有决定这份能力何时可用"
  },
  {
    "start": 353.25,
    "end": 354.25,
    "text": "在哪里运行"
  },
  {
    "start": 354.25,
    "end": 355.75,
    "text": "为谁工作的控制权"
  },
  {
    "start": 355.75,
    "end": 356.25,
    "text": "我是胡泊"
  },
  {
    "start": 356.25,
    "end": 358.016625,
    "text": "我们下期视频再见，拜拜"
  }
]